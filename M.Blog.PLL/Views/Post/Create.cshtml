@using M.Blog.PLL.Models.Post
@model NewPostViewModel


<h1>Добавление статьи</h1>
<form method="post">
    @for (int i = 0; i < Model.Tags.Count; i++)
    {
        <div class="form-check form-check-inline">
            @Html.CheckBoxFor(m => m.Tags[i].IsChecked)
            @Html.HiddenFor(m => m.Tags[i].Name)
            <label class="form-label">@Model.Tags[i].Name</label>
        </div>
    }
    <div class="mb-3">
        <label class="form-label">Заголовок</label>
        <input type="text" class="form-control" asp-for="Title" />
    </div>

    <div class="mb-3">
        <label class="form-label">Контент</label>
        <textarea type="text" class="form-control" asp-for="Content"></textarea>
    </div>


    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Добавить</button>
        <p></p>
        @Html.ActionLink("Перейти к списку всех статей", "Index", "Post")
    </div>
</form>
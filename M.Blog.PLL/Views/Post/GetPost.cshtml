@using M.Blog.PLL.Models.Post
@model PostViewModel;

<div class="card">
    <div clss="card-body">
        <h5 class="card-title">@Model.Title</h5>
        @if(Model.Tags.Count > 0)
        {
            foreach(var tag in Model.Tags)
            {
                <span class="role-name">@tag</span>
            }
        }
        <p class="card-text">@Model.Content</p>
        
    </div>
</div>
<h6>Автор статьи - @Model.Author</h6>
<div class="mt-3 position-relative">
    <label class="form-label">Комментарии к статье</label>
    @if(Model.Comments.Count > 0)
    {
        foreach (var comment in Model.Comments)
        {
            <div class="mb-3 border">
                <span>@comment.Content</span>
                <span class="p-1 rounded position-absolute bottom-0 end-0 bg-success text-light">@comment.AuthorName</span>
            </div>

        }
    }
</div>
<form method="post">
   <div class="mb-3">
        
        <textarea type="text" class="form-control" asp-for="NewComment"></textarea>
   </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Оставить комментарий</button>
    </div>

</form>


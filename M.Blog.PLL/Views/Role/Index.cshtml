@using M.Blog.PLL.Models.Role
@model List<RoleViewModel>

<h1>Все роли</h1>
@Html.ActionLink("Добавить роль", "Create", "Role")
<p></p>
@if (Model.Count > 0)
{
    foreach (var role in Model)
    {
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@role.Name</h5>
                @Html.ActionLink("Подробнее..", "GetRole", "Role", new { name = @role.Name })
            </div>
        </div>
    }
}
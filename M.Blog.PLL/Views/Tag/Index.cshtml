@using M.Blog.PLL.Models.Tag
@model List<TagViewModel>

<h1>Все теги</h1>
@Html.ActionLink("Добавить тег", "Create", "Tag")
<p></p>
@if(Model.Count > 0)
{
    <table class="table">

        <tbody>
            @foreach(var tag in Model)
            {
                <tr>
                    <td>@tag.Name</td>
                    <td>
                        <a class="btn btn-primary" asp-controller="Tag" asp-action="Update" asp-route-id=@tag.Id>Изменить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    
    

}
